# Development uses SQLite automatically when DATABASE_URL is omitted.
DATABASE_URL=postgresql+psycopg://medikiosk:medikiosk@postgres:5432/medikiosk
JWT_SECRET=replace-this-development-secret-before-deploying
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=medikiosk
MINIO_SECRET_KEY=medikiosk-demo-secret
MINIO_BUCKET_DOCUMENTS=medical-documents
MINIO_BUCKET_GENERATED=generated-files
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
MAX_UPLOAD_BYTES=10485760
ASR_PROVIDER=mock
OCR_PROVIDER=mock
LLM_PROVIDER=mock
ABDM_MODE=mock
HIS_MODE=mock

