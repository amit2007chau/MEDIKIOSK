<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MediKiosk | Clinical Intake Platform</title>

  <style>
    :root {
      --bg: #061f1b;
      --bg-soft: #092823;
      --card: #0d211e;
      --card-hover: #112b26;
      --border: #24433d;
      --text: #f2f4ee;
      --muted: #aebdb8;
      --accent: #26c6b0;
      --accent-soft: #153f38;
      --accent-dark: #0e302b;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
    }

    body {
      font-family:
        Inter,
        ui-sans-serif,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Arial,
        sans-serif;
      background:
        radial-gradient(
          circle at 50% 20%,
          rgba(38, 198, 176, 0.08),
          transparent 34%
        ),
        var(--bg);
      color: var(--text);
    }

    .page {
      width: min(1120px, 92vw);
      min-height: 100vh;
      margin: auto;
      display: flex;
      flex-direction: column;
    }

    /* Header */

    header {
      height: 88px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255,255,255,0.035);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text);
    }

    .brand-mark {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: var(--accent-soft);
      border: 1px solid rgba(38,198,176,0.35);
      display: grid;
      place-items: center;
      color: var(--accent);
      font-size: 17px;
      font-weight: 800;
      letter-spacing: -0.04em;
    }

    .brand-name {
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.08em;
    }

    .secure {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--muted);
      font-size: 12px;
    }

    .secure-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 0 4px rgba(38,198,176,0.08);
    }

    /* Main */

    main {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 58px 0 48px;
    }

    .intro {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 44px;
    }

    .eyebrow {
      margin: 0 0 16px;
      color: var(--accent);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(44px, 5vw, 66px);
      line-height: 1.05;
      font-weight: 500;
      letter-spacing: -0.035em;
      color: #f1eee5;
    }

    .intro-text {
      margin: 20px auto 0;
      max-width: 600px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.7;
    }

    /* Cards */

    .roles {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .role {
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 250px;
      padding: 26px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: rgba(13, 33, 30, 0.92);
      text-decoration: none;
      color: var(--text);
      transition:
        transform 160ms ease,
        border-color 160ms ease,
        background 160ms ease;
    }

    .role:hover {
      transform: translateY(-3px);
      border-color: rgba(38,198,176,0.5);
      background: var(--card-hover);
    }

    .role-icon {
      width: 44px;
      height: 44px;
      border-radius: 11px;
      display: grid;
      place-items: center;
      background: var(--accent-soft);
      border: 1px solid rgba(38,198,176,0.28);
      color: var(--accent);
      margin-bottom: 28px;
    }

    .role-icon svg {
      width: 21px;
      height: 21px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .role h2 {
      margin: 0 0 10px;
      font-size: 21px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .role p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.65;
      max-width: 290px;
    }

    .role-action {
      margin-top: auto;
      padding-top: 24px;
      color: var(--accent);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.01em;
    }

    .role-action::after {
      content: "  →";
      transition: margin-left 160ms ease;
    }

    .role:hover .role-action::after {
      margin-left: 4px;
    }

    /* Footer */

    footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 0 24px;
      border-top: 1px solid rgba(255,255,255,0.05);
      color: #718680;
      font-size: 11px;
    }

    /* Responsive */

    @media (max-width: 800px) {
      .roles {
        grid-template-columns: 1fr;
      }

      .role {
        min-height: 205px;
      }

      main {
        padding-top: 40px;
      }

      footer {
        gap: 15px;
        flex-direction: column;
        align-items: flex-start;
      }
    }

    @media (max-width: 520px) {
      .page {
        width: min(92vw, 420px);
      }

      header {
        height: 76px;
      }

      .secure {
        display: none;
      }

      h1 {
        font-size: 42px;
      }

      .intro {
        margin-bottom: 32px;
      }

      .role {
        padding: 22px;
      }
    }
  </style>
</head>

<body>

  <div class="page">

    <header>

      <a class="brand" href="#">
        <div class="brand-mark">M</div>
        <div class="brand-name">MEDIKIOSK</div>
      </a>

      <div class="secure">
        <span class="secure-dot"></span>
        <span>Private and secure</span>
      </div>

    </header>

    <main>

      <section class="intro">

        <p class="eyebrow">
          Clinical Intake Platform
        </p>

        <h1>
          Welcome to MediKiosk
        </h1>

        <p class="intro-text">
          Choose how you would like to continue.
          Each role opens the appropriate MediKiosk workspace.
        </p>

      </section>


      <section class="roles">

        <!-- Patient -->

        <a
          class="role"
          href="http://localhost:3000"
        >

          <div class="role-icon">

            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="8" r="3"></circle>
              <path d="M5 20c.8-3.4 3.1-5 7-5s6.2 1.6 7 5"></path>
            </svg>

          </div>

          <h2>Patient</h2>

          <p>
            Start your pre-consultation intake,
            consent, interview and document submission.
          </p>

          <div class="role-action">
            Start patient intake
          </div>

        </a>


        <!-- Doctor -->

        <a
          class="role"
          href="http://localhost:3001"
        >

          <div class="role-icon">

            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 3v5"></path>
              <path d="M5 5h4"></path>
              <path d="M17 3v5"></path>
              <path d="M15 5h4"></path>
              <path d="M6 8c0 5 2 8 6 8s6-3 6-8"></path>
              <path d="M12 16v5"></path>
              <path d="M8 21h8"></path>
            </svg>

          </div>

          <h2>Doctor</h2>

          <p>
            Open the clinical dashboard and
            sign in with your doctor credentials.
          </p>

          <div class="role-action">
            Doctor login
          </div>

        </a>


        <!-- Staff -->

        <a
          class="role"
          href="http://localhost:3002"
        >

          <div class="role-icon">

            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 5h16v11H4z"></path>
              <path d="M8 20h8"></path>
              <path d="M12 16v4"></path>
              <path d="M8 9h8"></path>
              <path d="M8 12h5"></path>
            </svg>

          </div>

          <h2>Staff</h2>

          <p>
            Open the triage queue and
            sign in with your staff credentials.
          </p>

          <div class="role-action">
            Staff login
          </div>

        </a>

      </section>

    </main>


    <footer>

      <span>
        Information is organized for clinical review.
      </span>

      <span>
        Clinical decisions remain with the treating clinician.
      </span>

    </footer>

  </div>

</body>
</html>